<%= if @rows == [] do %><p class="empty">nothing here yet.</p>
<% else %><ol class="log">
<%= for row <- @rows do %>  <li class="log-row">
    <a class="log-hash"<%= if row.commit_url do %> href="<%= escape(row.commit_url) %>"<% end %>><%= escape(row.hash) %></a>
    <time class="log-date" datetime="<%= escape(row.date) %>"><%= escape(row.date) %></time>
    <span class="log-type"><%= escape(row.type) %></span>
    <a class="log-title <%= escape(row.vt) %>" href="<%= escape(row.href) %>"><%= escape(row.title) %></a>
  </li>
<% end %></ol>
<% end %>
