<%= bar(%{esc: true}) %>

<main id="main" class="article project">
  <article>
<%= meta(%{class: "meta", parts: @meta}) %>
    <h1><%= escape(@entry.title) %></h1>
    <p class="lede"><%= escape(@entry.tagline) %></p>
<%= if @facts != [] do %><%= meta(%{class: "facts", parts: @facts}) %>
<% end %>
    <div class="prose">
<%= raw(@entry.html) %>
    </div>

<%= article_end(%{links: @links}) %>
  </article>
</main>
