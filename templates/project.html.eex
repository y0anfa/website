<article class="prose project">
  <h1 class="<%= escape(Site.Transitions.class(@entry.slug)) %>"><%= escape(@entry.title) %></h1>
  <p class="tagline"><%= escape(@entry.tagline) %></p>
<%= meta(%{parts: @meta}) %>
<%= raw(@entry.html) %>
  <div class="entry-end">
    <p class="back"><a href="/">← log</a></p>
<%= entry_links(%{links: @links}) %>
  </div>
</article>
