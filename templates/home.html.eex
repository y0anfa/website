<div class="intro">
  <h1><%= escape(@doc.title) %></h1>
<%= if @doc.tagline do %>  <p class="tagline"><%= escape(@doc.tagline) %></p>
<% end %><%= raw(@doc.html) %>
  <p class="contact"><a href="mailto:<%= escape(Site.Config.email()) %>"><%= escape(Site.Config.email()) %></a> · <a href="<%= escape(Site.Config.linkedin()) %>" rel="noopener">linkedin</a></p>
</div>
<section class="log-section" aria-labelledby="log-h">
  <h2 id="log-h">log</h2>
<%= log(%{rows: @rows}) %>
</section>
