<div class="corner">
<a class="corner-link" href="<%= escape(@linkedin) %>" rel="me noopener" aria-label="LinkedIn">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.75" y="1.75" width="12.5" height="12.5" rx="2.75"/><path d="M5 7v4.25M8 11.25V7m0 1.9c0-1.1.75-1.9 1.75-1.9s1.6.8 1.6 1.9v2.35"/><circle cx="5" cy="4.75" r=".4" fill="currentColor" stroke="none"/></svg>
</a>
<%= toggle() %>
</div>

<main id="main" class="stage">
  <section class="identity" aria-labelledby="name">
    <div class="name-wrap">
      <h1 class="name" id="name">
<%= for line <- @name_lines do %>        <span class="name-line"><span><%= escape(line) %></span></span>
<% end %>      </h1>
      <div class="name-lit" aria-hidden="true">
        <div class="name-lit-inner">
          <p class="name">
<%= for line <- @name_lines do %>            <span class="name-line"><span><%= escape(line) %></span></span>
<% end %>          </p>
        </div>
      </div>
    </div>
    <p class="role"><%= escape(@role.title) %> at <a class="text-link" href="<%= escape(@role.url) %>" rel="noopener"><%= escape(@role.company) %></a></p>
  </section>

<%= feed(%{years: @years}) %>
</main>

<div class="spot" aria-hidden="true"></div>
<div class="beam" aria-hidden="true"></div>
<div class="bead" aria-hidden="true"><span class="bead-date"></span></div>
