<!doctype html>
<html lang="en" data-vt="morph">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= escape(@title) %></title>
<meta name="description" content="<%= escape(@description) %>">
<meta name="color-scheme" content="light dark">
<%= if @url do %><link rel="canonical" href="<%= escape(@url) %>">
<meta property="og:url" content="<%= escape(@url) %>">
<% end %><meta property="og:title" content="<%= escape(@title) %>">
<meta property="og:description" content="<%= escape(@description) %>">
<meta property="og:type" content="<%= escape(@og_type) %>">
<%= if @og_image do %><meta property="og:image" content="<%= escape(@og_image) %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= escape(@title) %>">
<meta name="twitter:card" content="summary_large_image">
<% else %><meta name="twitter:card" content="summary">
<% end %><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<%= if @markdown do %><link rel="alternate" type="text/markdown" href="<%= escape(@markdown) %>">
<% end %><link rel="preload" href="/assets/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
<script><%= raw(@head_js) %></script>
<script type="speculationrules"><%= raw(@speculation) %></script>
<link rel="stylesheet" href="/assets/css/site.css">
<link rel="stylesheet" href="/assets/css/transitions.css">
<script type="module" src="/assets/js/field.js"></script>
<%= for src <- @scripts do %><script defer src="<%= escape(src) %>"></script>
<% end %></head>
<body data-page="<%= escape(@page_key) %>">
<a class="skip-link" href="#main">skip to content</a>
<div class="field" data-field-root aria-hidden="true"><canvas class="field-canvas"></canvas></div>
<%= header() %>
<main id="main">
<%= raw(@content) %>
</main>
<%= footer(%{build: @build}) %>
</body>
</html>
