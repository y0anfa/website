{
  // Assets-only Worker: serves the static site built into ./dist.
  // There is no `main` entry point; Cloudflare serves the assets directly.
  "name": "yoanfaure",
  "compatibility_date": "2026-10-01",

  // The apex is a Workers custom domain: Cloudflare owns its DNS record and
  // certificate. www and the old domain redirect here (see redirect/).
  "routes": [{ "pattern": "yoanfaure.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist",
    // Unknown paths serve dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // /rhino serves /rhino/index.html; /rhino/ also resolves.
    "html_handling": "auto-trailing-slash"
  }
}
